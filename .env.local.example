NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_, this must stay off the client.
FINNHUB_API_KEY=your-finnhub-api-key

# Optional — defaults to the current Vercel URL if unset. Set this once a
# custom domain is attached, so SEO metadata (canonical/OG/sitemap) points
# at the real domain instead of the .vercel.app one.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
